/**
 * canvas 绘制标尺
 * 
 * params:{*}
 *      axisWidth:Number,轴线的宽度，单位px
 * 			axisOrigin:array,轴线的原点
 *      lineColor:String,轴线的颜色
 *      gridWidth:Number,大网格的宽度
 *      gridHeight:Number,大网格的高度
 * 			drawType:String,标尺类型'horizontal''vertical''all''none'
 * 			canvasSize:Number,标尺缩放比例
 * 			unitConversionRatio,毫米与像素单位比
 * 
 * dom:Dom元素,canvas的元素
 */

function CanvasRuler(params, dom) {
  let AXIS_WIDTH = 1,
  	AXIS_ORIGIN = [0,0],
    LINE_COLOR = "#000000",
    GRID_WIDTH = 100,
    GRID_HEIGHT = 20,
    DRAW_TYPE = 'all',
    CANVAS_SIZE = 1,
    UNIT_CONVERSION_RATIO = 1;

  let canvas = dom;
	
  this.setAxisWidth = function(axisWidth) {
    AXIS_WIDTH = Number(axisWidth) ? Number(axisWidth) : 1;
  }
  this.getAxisWidth = function() {
    return AXIS_WIDTH;
  }
  
  this.setAxisOrigin = function(axisOrigin) {
    AXIS_ORIGIN = [Number(axisOrigin[0]) ? Number(axisOrigin[0]) : 0,Number(axisOrigin[1]) ? Number(axisOrigin[1]) : 0];
  }
  this.getAxisOrigin = function() {
    return AXIS_ORIGIN;
  }

  this.setLineColor = function(lineColor) {
    LINE_COLOR = lineColor;
  }
  this.getLineColor = function() {
    return LINE_COLOR;
  }

  this.setGridWidth = function(gridWidth) {
    GRID_WIDTH = Number(gridWidth) ? Number(gridWidth) : 1;
  }
  this.getGridWidth = function() {
    return GRID_WIDTH;
  }

  this.setGridHeight = function(gridHeight) {
    GRID_HEIGHT = Number(gridHeight) ? Number(gridHeight) : 1;
  }
  this.getGridHeight = function() {
    return GRID_HEIGHT;
  }
  
  this.getDrawType = function() {
    return DRAW_TYPE;
  }
	this.setDrawType = function(drawType) {
    DRAW_TYPE = drawType ? drawType : 'all';
  }
	
	this.getCanvasSize = function() {
    return CANVAS_SIZE;
  }
	this.setCanvasSize = function(canvasSize) {
    CANVAS_SIZE =  Number(canvasSize) ? Number(canvasSize) : 1;
  }
	
	this.getUnitConversionRatio = function() {
    return UNIT_CONVERSION_RATIO;
  }
	this.setUnitConversionRatio = function(unitConversionRatio) {
    UNIT_CONVERSION_RATIO =  Number(unitConversionRatio) ? Number(unitConversionRatio) : 1;
  }

  this.getDomElement = function() { 
    return canvas;
  }

  this.clearCanvas = function() {//清空canvas
    canvas.width = canvas.width;
  }
  
  this.setAxisWidth(params.axisWidth);
  this.setAxisOrigin(params.axisOrigin);
  this.setLineColor(params.lineColor);
  this.setGridWidth(params.gridWidth);
  this.setGridHeight(params.gridHeight);
	this.setDrawType(params.drawType);
	this.setCanvasSize(params.canvasSize);
	this.setUnitConversionRatio(params.unitConversionRatio);
}

CanvasRuler.prototype = {
  constructor: CanvasRuler,
  init: function() {
  	var type = this.getDrawType();
    this.drawAxis(type);
  },
  update: function(params){
  	this.setAxisOrigin(params.axisOrigin);
	  this.setCanvasSize(params.canvasSize);
	  this.init();
  },

	drawAxis: function(type) {
    this.clearCanvas();
    var scaleLine = this.getDomElement().getContext('2d');
    scaleLine.lineWidth = this.getAxisWidth();
    scaleLine.strokeStyle = this.getLineColor();
    var scaleText = this.getDomElement().getContext('2d');
    
    let gridWidth = this.getGridWidth();
    let canvasSize = this.getCanvasSize();
    let unitConvRatio = this.getUnitConversionRatio();
    let showGridWidth = gridWidth * canvasSize / unitConvRatio;
    //console.log(gridWidth+'---1----'+showGridWidth)
    //调整缩放后的网格宽度
    if(showGridWidth<30){
    	this.setGridWidth(Math.round(5/canvasSize*unitConvRatio)*10);
    	gridWidth = this.getGridWidth();
    	showGridWidth = gridWidth * canvasSize / unitConvRatio;
    	//console.log('小了')
    }else if(showGridWidth>60){ 
    	let newWidth = Math.round(4/canvasSize*unitConvRatio)*10;
    	this.setGridWidth(newWidth < 10 ? 10 : newWidth);
    	gridWidth = this.getGridWidth();
    	showGridWidth = gridWidth * canvasSize /unitConvRatio;
    	//console.log('大了')
    }
    //console.log(gridWidth+'---2----'+showGridWidth)
    switch (type) {
      case 'horizontal':
        this.drawHorizontalAxis(scaleLine,scaleText,showGridWidth);
        break;
      case 'vertical':
        this.drawVerticalAxis(scaleLine,scaleText,showGridWidth);
        break;
      case 'all':
        this.drawHorizontalAxis(scaleLine,scaleText,showGridWidth);
        this.drawVerticalAxis(scaleLine,scaleText,showGridWidth);
        break;
      default:
        break;
    }
  },
  //绘制水平轴
  drawHorizontalAxis: function(scaleLine,scaleText,showGridWidth) {
		let gridWidth = this.getGridWidth();
    let gridHeight = this.getGridHeight();
    let domWidth = this.getDomElement().width;
    let axisOriginX = this.getAxisOrigin()[0];
    //标尺背景
    scaleLine.rect(0, 0, domWidth, gridHeight);
    scaleLine.fillStyle="#f2f2f2";
    scaleLine.fill();
    //标尺下边线
    scaleLine.beginPath();
    scaleLine.moveTo(gridHeight, gridHeight - 0.5);
    scaleLine.lineTo(domWidth, gridHeight - 0.5);  
    scaleLine.stroke();
    //标尺文本颜色
    scaleText.fillStyle = "#a2a2a2";
    //正数刻度线及文本
    for (let i = axisOriginX + 0.5; i < domWidth; i = i + showGridWidth) {
    	if(i > gridHeight){
    		scaleLine.beginPath();
	      scaleLine.moveTo(i, 0);
	      scaleLine.lineTo(i, gridHeight);
	      
	      scaleText.fillText(Math.round((i - axisOriginX - 0.5)/showGridWidth*gridWidth), i + 2 , 11);
    	}    	
      for (let j = i + showGridWidth / 10; j < i + showGridWidth; j = j + showGridWidth / 10) {
      	if(j > gridHeight){
	        scaleLine.moveTo(j, gridHeight);
	        if (j == i + showGridWidth / 10 * 5) {
	          scaleLine.lineTo(j, gridHeight / 2);
	        } else {
	          scaleLine.lineTo(j, gridHeight * 2 / 3);
	        }
	      }
      }
      scaleLine.stroke();
    }
    //负数刻度线及文本
    for (let i = axisOriginX + 0.5; i > gridHeight; i = i - showGridWidth) {
      scaleLine.beginPath();
      scaleLine.moveTo(i, 0);
      scaleLine.lineTo(i, gridHeight);
      
      scaleText.fillText(Math.round((i - axisOriginX - 0.5)/showGridWidth*gridWidth), i + 2 , 11);
      
      for (let j = i - showGridWidth / 10; j > i - showGridWidth; j = j - showGridWidth / 10) {
      	if(j > gridHeight){
	        scaleLine.moveTo(j, gridHeight);
	        if (j == i - showGridWidth / 10 * 5) {
	          scaleLine.lineTo(j, gridHeight / 2);
	        } else if(j > gridHeight){
	          scaleLine.lineTo(j, gridHeight * 2 / 3);
	        }
        }
      }
      scaleLine.stroke();
    }
    
  },

  //绘制垂直轴
  drawVerticalAxis: function(scaleLine,scaleText,showGridWidth) {
		let gridWidth = this.getGridWidth();
    let gridHeight = this.getGridHeight();
    let domHeight = this.getDomElement().height;
    let axisOriginY= this.getAxisOrigin()[1];
    
    scaleLine.rect(0, 0, gridHeight - 0.5, domHeight);
    scaleLine.fillStyle="#f2f2f2";
    scaleLine.fill();
    
    scaleLine.beginPath();
    scaleLine.moveTo(gridHeight - 0.5, gridHeight);
    scaleLine.lineTo(gridHeight - 0.5, domHeight);
    scaleLine.stroke();
    
    scaleText.fillStyle = "#a2a2a2";
    
    for (let i = axisOriginY + 0.5; i < domHeight; i = i + showGridWidth) {
    	if(i > gridHeight){
	      scaleLine.beginPath();
	      scaleLine.moveTo(0, i);
	      scaleLine.lineTo(gridHeight, i);
     	}
      
      for (let j = i + showGridWidth / 10; j < i + showGridWidth; j = j + showGridWidth / 10) {
      	if(j > gridHeight){
	        scaleLine.moveTo(gridHeight, j);
	        if (j == i + showGridWidth / 10 * 5) {
	          scaleLine.lineTo(gridHeight / 2, j);
	        } else {
	          scaleLine.lineTo(gridHeight * 2 / 3, j);
	        }
        }
      }
      scaleLine.stroke();
    }
    for (let i = axisOriginY + 0.5; i > gridHeight; i = i - showGridWidth) {
      scaleLine.beginPath();
      scaleLine.moveTo(0, i);
      scaleLine.lineTo(gridHeight, i);
      
      for (let j = i - showGridWidth / 10; j > i - showGridWidth; j = j - showGridWidth / 10) {
      	if(j > gridHeight){
	        scaleLine.moveTo(gridHeight, j);
	        if (j == i - showGridWidth / 10 * 5) {
	          scaleLine.lineTo(gridHeight / 2, j);
	        } else{
	          scaleLine.lineTo(gridHeight * 2 / 3, j);
	        }
        }
      }
      scaleLine.stroke();
    }
    scaleText.translate(0, axisOriginY + 0.5);
  	scaleText.rotate( 90* Math.PI/180);
    for (let i = axisOriginY + 0.5; i < domHeight; i = i + showGridWidth) { 
    	if(i > gridHeight){
	      scaleText.fillText(Math.round((i - axisOriginY - 0.5)/showGridWidth*gridWidth), i - axisOriginY + 2, -3);
     }      
    }
    for (let i = axisOriginY + 0.5; i > gridHeight; i = i - showGridWidth) {
      scaleText.fillText(Math.round((i - axisOriginY - 0.5)/showGridWidth*gridWidth), i - axisOriginY + 2, -3);
    }
  }

}